<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:ignore="FullScreenIntentPolicy" />
    <uses-permission android:name="org.codeaurora.permission.POWER_OFF_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:ignore="ExactAlarmPolicy" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <application
        android:name="com.qwibbler.salarm.SalarmApplication"
        android:allowBackup="false"
        android:appCategory="productivity"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appName}"
        android:requiredForAllUsers="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Salarm"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        tools:ignore="DataExtractionRules, UnusedTranslation">

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- ============================================================== -->
        <!-- Main app components.                                           -->
        <!-- ============================================================== -->

        <activity
            android:name="com.qwibbler.salarm.setup.FirstLaunch"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Salarm">
        </activity>

        <activity
            android:name="com.qwibbler.salarm.SalarmActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.qwibbler.salarm.ringtone.RingtonePickerActivity"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Salarm" />

        <activity
            android:name="com.qwibbler.salarm.worldclock.CitySelectionActivity"
            android:excludeFromRecents="true"
            android:label="@string/cities_activity_title"
            android:parentActivityName=".SalarmActivity"
            android:taskAffinity=""
            android:theme="@style/Theme.Salarm" />

        <activity
            android:name="com.qwibbler.salarm.settings.SettingsActivity"
            android:excludeFromRecents="true"
            android:label="@string/settings"
            android:parentActivityName=".SalarmActivity"
            android:taskAffinity=""
            android:theme="@style/Theme.Salarm"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.qwibbler.salarm.settings.PermissionsManagementActivity"
            android:excludeFromRecents="true"
            android:label="@string/permission_management_settings"
            android:taskAffinity=""
            android:theme="@style/Theme.Salarm" />

        <activity
            android:name="com.qwibbler.salarm.controller.HandleShortcuts"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name="com.qwibbler.salarm.base.KeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Used to keep the app alive" />
        </service>

        <!-- ============================================================== -->
        <!-- AlarmClock API components.                                     -->
        <!-- ============================================================== -->

        <activity
            android:name="com.qwibbler.salarm.controller.HandleApiCalls"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.DISMISS_ALARM" />
                <action android:name="android.intent.action.DISMISS_TIMER" />
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <action android:name="android.intent.action.SHOW_TIMERS" />
                <action android:name="android.intent.action.SNOOZE_ALARM" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="com.qwibbler.salarm.HandleSetAlarmApiCalls"
            android:permission="com.android.alarm.permission.SET_ALARM"
            android:exported="true"
            android:targetActivity="com.qwibbler.salarm.controller.HandleApiCalls">
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <action android:name="android.intent.action.SET_TIMER" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- ============================================================== -->
        <!-- Alarm components.                                              -->
        <!-- ============================================================== -->

        <activity
            android:name="com.qwibbler.salarm.alarms.AlarmActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Salarm.Wallpaper"
            android:windowSoftInputMode="stateAlwaysHidden"
            tools:ignore="DiscouragedApi, NonResizeableActivity" />

        <activity
            android:name="com.qwibbler.salarm.settings.AlarmDisplayPreviewActivity"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Salarm.Wallpaper" />

        <activity
            android:name="com.qwibbler.salarm.alarms.alarmselection.AlarmSelectionActivity"
            android:label="@string/dismiss_alarm"
            android:theme="@android:style/Theme.Material.Dialog.NoActionBar" />

        <provider
            android:name="com.qwibbler.salarm.provider.ClockProvider"
            android:authorities="${applicationId}"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name="com.qwibbler.salarm.alarms.AlarmInitReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.APPLICATION_LOCALE_CHANGED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="org.codeaurora.poweroffalarm.action.UPDATE_ALARM" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.qwibbler.salarm.base.PackageReplacedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.qwibbler.salarm.alarms.AlarmStateManager"
            android:exported="false"
            android:directBootAware="true" />

        <service
            android:name="com.qwibbler.salarm.alarms.AlarmService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Used to notify the user that alarms are running" />
        </service>

        <!-- ============================================================== -->
        <!-- Timer components.                                              -->
        <!-- ============================================================== -->

        <activity
            android:name="com.qwibbler.salarm.timer.ExpiredTimersActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:resizeableActivity="false"
            android:turnScreenOn="true"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Salarm.Wallpaper"
            tools:ignore="DiscouragedApi, NonResizeableActivity" />

        <activity
            android:name="com.qwibbler.salarm.settings.TimerDisplayPreviewActivity"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Salarm.Wallpaper" />

        <receiver
            android:name="com.qwibbler.salarm.timer.TimerAlertReceiver"
            android:exported="false"
            android:directBootAware="true" />

        <service
            android:name="com.qwibbler.salarm.timer.TimerService"
            android:description="@string/timer_service_desc"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Used to notify the user that timers are running" />
        </service>

        <!-- ============================================================== -->
        <!-- Stopwatch components.                                          -->
        <!-- ============================================================== -->

        <service
            android:name="com.qwibbler.salarm.stopwatch.StopwatchService"
            android:description="@string/stopwatch_service_desc"
            android:directBootAware="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Used to notify the user that stopwatch is running" />
        </service>

        <!-- ============================================================== -->
        <!-- Screen saver components.                                       -->
        <!-- ============================================================== -->

        <activity
            android:name="com.qwibbler.salarm.screensaver.ScreensaverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Salarm"
            tools:ignore="DiscouragedApi, NonResizeableActivity" />

        <activity
            android:name="com.qwibbler.salarm.settings.ScreensaverSettingsActivity"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Salarm" />

        <service
            android:name="com.qwibbler.salarm.screensaver.Screensaver"
            android:exported="true"
            android:label="@string/app_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <action android:name="com.qwibbler.salarm.NEXT_ALARM_CHANGED_BY_CLOCK" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/screensaver_info" />
        </service>

        <!-- Receiver for handling the daily update of app widgets at midnight
             and more mainly the widgets that display the date -->
        <receiver
            android:name="com.qwibbler.salarm.widgets.DailyWidgetUpdateReceiver"
            android:directBootAware="true">
        </receiver>

        <receiver
            android:name="com.qwibbler.salarm.widgets.SalahWidgetUpdateReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.qwibbler.salarm.SALAH_MINUTE_UPDATE" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ============================================================== -->
        <!-- App widget components.                                         -->
        <!-- ============================================================== -->

        <!-- Analog clock -->
        <activity
            android:name="com.qwibbler.salarm.widgets.WidgetConfiguration$AnalogWidgetConfiguration"
            android:excludeFromRecents="true"
            android:label="@string/analog_widget"
            android:theme="@style/Theme.Salarm" />

        <receiver
            android:name="com.qwibbler.salarm.widgets.AnalogAppWidgetProvider"
            android:exported="true"
            android:label="@string/analog_widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_analog" />
        </receiver>

        <!-- Digital clock -->
        <activity
            android:name="com.qwibbler.salarm.widgets.WidgetConfiguration$DigitalWidgetConfiguration"
            android:excludeFromRecents="true"
            android:label="@string/digital_widget"
            android:theme="@style/Theme.Salarm" />

        <receiver
            android:name="com.qwibbler.salarm.widgets.DigitalAppWidgetProvider"
            android:exported="true"
            android:label="@string/digital_widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.APPLICATION_LOCALE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="com.qwibbler.salarm.ON_DAY_CHANGE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_digital" />
        </receiver>

        <service
            android:name="com.qwibbler.salarm.widgets.AppWidgetCityService$DigitalAppWidgetCityService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Vertical clock -->
        <activity
            android:name="com.qwibbler.salarm.widgets.WidgetConfiguration$VerticalWidgetConfiguration"
            android:excludeFromRecents="true"
            android:label="@string/vertical_widget"
            android:theme="@style/Theme.Salarm" />

        <receiver
            android:name="com.qwibbler.salarm.widgets.VerticalAppWidgetProvider"
            android:exported="true"
            android:label="@string/vertical_widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.APPLICATION_LOCALE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_vertical" />
        </receiver>

        <!-- Next alarm -->
        <activity
            android:name="com.qwibbler.salarm.widgets.WidgetConfiguration$NextAlarmWidgetConfiguration"
            android:excludeFromRecents="true"
            android:label="@string/next_alarm_widget"
            android:theme="@style/Theme.Salarm" />

        <receiver
            android:name="com.qwibbler.salarm.widgets.NextAlarmAppWidgetProvider"
            android:exported="true"
            android:label="@string/next_alarm_widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.APPLICATION_LOCALE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_next_alarm" />
        </receiver>

        <activity
            android:name="com.qwibbler.salarm.widgets.WidgetConfiguration$SalahWidgetConfiguration"
            android:excludeFromRecents="true"
            android:label="@string/salah_timeline_widget_label"
            android:theme="@style/Theme.Salarm" />



        <activity
            android:name="com.qwibbler.salarm.widgets.WidgetConfiguration$SalahCountdownWidgetConfiguration"
            android:excludeFromRecents="true"
            android:label="@string/salah_countdown_widget_label"
            android:theme="@style/Theme.Salarm" />

        <!-- Salah timeline widget -->
        <receiver
            android:name="com.qwibbler.salarm.widgets.SalahTimelineWidgetProvider"
            android:exported="true"
            android:label="@string/salah_timeline_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.APPLICATION_LOCALE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_salah_timeline_info" />
        </receiver>



        <!-- Salah countdown widget -->
        <receiver
            android:name="com.qwibbler.salarm.widgets.SalahCountdownWidgetProvider"
            android:exported="true"
            android:label="@string/salah_countdown_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.APPLICATION_LOCALE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_salah_countdown_info" />
        </receiver>

        <!-- ============================================================== -->
        <!-- Tiles.                                                         -->
        <!-- ============================================================== -->

        <!-- Alarm tile -->
        <service
            android:name="com.qwibbler.salarm.tiles.AlarmTileService"
            android:exported="true"
            android:label="@string/menu_alarm"
            android:icon="@drawable/ic_tab_alarm_static"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Timer tile -->
        <service
            android:name="com.qwibbler.salarm.tiles.TimerTileService"
            android:exported="true"
            android:label="@string/menu_timer"
            android:icon="@drawable/ic_tab_timer_static"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Stopwatch tile -->
        <service
            android:name="com.qwibbler.salarm.tiles.StopwatchTileService"
            android:exported="true"
            android:label="@string/menu_stopwatch"
            android:icon="@drawable/ic_tab_stopwatch_static"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Screensaver tile -->
        <service
            android:name="com.qwibbler.salarm.tiles.ScreensaverTileService"
            android:exported="true"
            android:label="@string/screensaver_settings_title"
            android:icon="@drawable/ic_screensaver"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
