<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/salah_location_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="key_salah_location_mode"
            android:layout="@layout/settings_preference_layout"
            android:title="Location Mode"
            android:summary="%s"
            android:entries="@array/salah_location_mode_entries"
            android:entryValues="@array/salah_location_mode_values"
            android:defaultValue="GPS"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <Preference
            android:key="key_salah_city_name"
            android:layout="@layout/settings_preference_layout"
            android:title="City"
            android:summary="not detected"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/salah_prayer_settings_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="key_salah_calc_method"
            android:layout="@layout/settings_preference_layout"
            android:title="Calculation Method"
            android:summary="%s"
            android:entries="@array/salah_calc_method_entries"
            android:entryValues="@array/salah_calc_method_values"
            android:defaultValue="KARACHI"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <ListPreference
            android:key="key_salah_madhab"
            android:layout="@layout/settings_preference_layout"
            android:title="Madhab"
            android:summary="%s"
            android:entries="@array/salah_madhab_entries"
            android:entryValues="@array/salah_madhab_values"
            android:defaultValue="HANAFI"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/salah_advanced_settings_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_show_both_asr"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/show_both_asr_title"
            android:summary="@string/show_both_asr_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_show_both_asr_in_alarm_events"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/show_both_asr_in_alarm_events_title"
            android:defaultValue="false"
            android:dependency="key_salah_show_both_asr"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_show_both_asr_in_salah_times"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/show_both_asr_in_salah_times_title"
            android:defaultValue="false"
            android:dependency="key_salah_show_both_asr"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_show_both_asr_in_widgets"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/show_both_asr_in_widgets_title"
            android:defaultValue="false"
            android:dependency="key_salah_show_both_asr"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <Preference
            android:key="key_salah_time_rounding_settings"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/salah_time_rounding_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</PreferenceScreen>
