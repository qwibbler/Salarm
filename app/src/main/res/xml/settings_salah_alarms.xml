<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/salah_alarms_settings_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_alarm_show_rounding"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/show_rounding_option_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_adjust_alarm_after_rounding"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/adjust_alarm_after_rounding_title"
            android:summary="@string/adjust_alarm_after_rounding_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_autodismiss_by_default"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/autodismiss_default_title"
            android:summary="@string/autodismiss_default_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/style_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_alarm_style_override"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/salah_alarm_style_override_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <Preference
            android:key="key_salah_alarm_display_customization"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/salah_alarm_display_settings_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/ringtone_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_alarm_ringtone_override"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/salah_alarm_ringtone_override_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <Preference
            android:key="key_salah_default_alarm_ringtone"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/default_alarm_ringtone_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.AutoSilenceDurationPreference
            android:key="key_salah_auto_silence_duration"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/auto_silence_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_enable_per_alarm_auto_silence"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/enable_per_alarm_auto_silence_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.AlarmSnoozeDurationPreference
            android:key="key_salah_alarm_snooze_duration"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/snooze_duration_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_enable_per_alarm_snooze_duration"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/enable_per_alarm_snooze_duration_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.DismissAfterPreference
            android:key="key_salah_alarm_dismiss_after"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/dismiss_after_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_enable_per_alarm_dismiss_after"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/enable_per_alarm_dismiss_after_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <ListPreference
            android:key="key_salah_repeat_missed_alarm"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/missed_alarm_repeat_limit_title"
            android:entries="@array/missed_alarm_repeat_limit_entries"
            android:entryValues="@array/missed_alarm_repeat_limit_values"
            android:defaultValue="-1"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_enable_per_alarm_missed_repeat_limit"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/enable_per_alarm_missed_repeat_limit_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.AlarmVolumePreference
            android:key="key_salah_volume_setting"
            android:layout="@layout/settings_preference_slider_layout"
            android:title="@string/alarm_volume_title"
            android:summary="0"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_enable_per_alarm_volume"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/enable_per_alarm_volume_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.VolumeCrescendoDurationPreference
            android:key="key_salah_alarm_volume_crescendo_duration"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/crescendo_duration_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_enable_per_alarm_volume_crescendo_duration"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/enable_per_alarm_crescendo_duration_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/advanced_audio_playback_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_alarm_advanced_audio_override"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/salah_alarm_advanced_audio_override_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_advanced_audio_playback"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/advanced_audio_playback_title"
            android:summary="@string/advanced_audio_playback_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_auto_routing_to_external_audio_device"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/auto_routing_to_external_audio_device_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_system_media_volume"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/system_media_volume_title"
            android:summary="@string/system_media_volume_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.CustomSliderPreference
            android:key="key_salah_external_audio_device_volume"
            android:layout="@layout/settings_preference_slider_layout"
            android:title="@string/external_audio_device_volume_title"
            android:summary="@string/label_default"
            android:defaultValue="70"
            android:max="100"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/vibration_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_alarm_vibration_override"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/salah_alarm_vibration_override_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_enable_alarm_vibrations_by_default"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/enable_alarm_vibrations_by_default_setting_title"
            android:summary="@string/alarm_settings_general_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.VibrationPatternPreference
            android:key="key_salah_vibration_pattern"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/vibration_pattern_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_enable_per_alarm_vibration_pattern"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/enable_per_alarm_vibration_pattern_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.VibrationStartDelayPreference
            android:key="key_salah_vibration_start_delay"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/vibration_start_delay_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_enable_snoozed_or_dismissed_alarm_vibrations"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/enable_snoozed_or_dismissed_alarm_vibrations_title"
            android:summary="@string/enable_snoozed_or_dismissed_alarm_vibrations_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/actions_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_alarm_actions_override"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/salah_alarm_actions_override_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <ListPreference
            android:key="key_salah_volume_button_setting"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/volume_button_setting_title"
            android:entries="@array/volume_button_setting_entries"
            android:entryValues="@array/volume_button_setting_values"
            android:defaultValue="-1"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <ListPreference
            android:key="key_salah_power_button"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/power_button_title"
            android:entries="@array/action_setting_entries"
            android:entryValues="@array/side_button_setting_values"
            android:defaultValue="0"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <ListPreference
            android:key="key_salah_headphones_button"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/headphones_button_title"
            android:entries="@array/action_setting_entries"
            android:entryValues="@array/side_button_setting_values"
            android:defaultValue="0"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <ListPreference
            android:key="key_salah_flip_action"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/flip_action_title"
            android:entries="@array/action_setting_entries"
            android:entryValues="@array/side_button_setting_values"
            android:defaultValue="0"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <ListPreference
            android:key="key_salah_shake_action"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/shake_action_title"
            android:entries="@array/action_setting_entries"
            android:entryValues="@array/side_button_setting_values"
            android:defaultValue="0"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.CustomSliderPreference
            android:key="key_salah_shake_intensity"
            android:layout="@layout/settings_preference_slider_layout"
            android:title="@string/shake_intensity_title"
            android:summary="@string/label_default"
            android:defaultValue="16"
            android:max="55"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/miscellaneous_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_alarm_misc_override"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/salah_alarm_misc_override_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_display_dismiss_button"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/display_dismiss_button_title"
            android:summary="@string/display_dismiss_button_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.AlarmNotificationReminderPreference
            android:key="key_salah_alarm_notification_reminder"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/alarm_notification_reminder_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_turn_on_back_flash_for_triggered_alarm"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/turn_on_back_flash_for_triggered_alarm_title"
            android:summary="@string/alarm_settings_general_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <androidx.preference.SwitchPreferenceCompat
            android:key="key_salah_display_low_alarm_volume_warning"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/display_low_alarm_volume_warning_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</PreferenceScreen>
