<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/style_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="key_salah_countdown_widget_display_text_uppercase"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/display_text_uppercase_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_salah_countdown_widget_show_symbols"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/salah_widget_display_symbols_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_salah_countdown_widget_display_text_shadow"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/display_text_shadow_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_salah_countdown_widget_display_background"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/widget_background_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_salah_countdown_widget_customize_background_corner_radius"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/customize_background_corner_radius_title"
            android:summary="@string/customize_background_corner_radius_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.CustomSliderPreference
            android:key="key_salah_countdown_widget_background_corner_radius"
            android:layout="@layout/settings_preference_slider_layout"
            android:title="@string/background_corner_radius_title"
            android:summary="@string/label_default"
            android:defaultValue="24"
            android:max="100"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_salah_countdown_widget_apply_horizontal_padding"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/widget_apply_horizontal_padding_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/colors_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="key_salah_countdown_widget_default_background_color"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/background_default_color_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.ColorPickerPreference
            android:key="key_salah_countdown_widget_custom_background_color"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/background_color_title"
            android:defaultValue="#70000000"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_salah_countdown_widget_default_time_color"
            android:layout="@layout/settings_preference_layout"
            android:title="Countdown time default color"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.ColorPickerPreference
            android:key="key_salah_countdown_widget_custom_time_color"
            android:layout="@layout/settings_preference_layout"
            android:title="Countdown time color"
            android:defaultValue="#FFFFFF"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_salah_countdown_widget_default_label_color"
            android:layout="@layout/settings_preference_layout"
            android:title="Countdown label default color"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.qwibbler.salarm.settings.custompreference.ColorPickerPreference
            android:key="key_salah_countdown_widget_custom_label_color"
            android:layout="@layout/settings_preference_layout"
            android:title="Countdown label color"
            android:defaultValue="#FFFFFF"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/font_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <com.qwibbler.salarm.settings.custompreference.CustomSliderPreference
            android:key="key_salah_countdown_widget_maximum_font_size"
            android:layout="@layout/settings_preference_slider_layout"
            android:title="@string/max_clock_font_size_title"
            android:summary="@string/label_default"
            android:defaultValue="70"
            android:max="200"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</PreferenceScreen>
