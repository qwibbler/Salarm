<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="key_namaz_compact_widget_events_category"
        android:title="@string/namaz_widget_events_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_show_both_asrs"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/show_both_asr_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_show_fajr"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/fajr_label"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_show_sunrise"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/sunrise_label"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_show_dhuhr"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/dhuhr_label"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_show_asr"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/asr_label"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_show_asr_shafi"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/asr_shafii_label"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_show_asr_hanafi"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/asr_hanafi_label"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_show_maghrib"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/maghrib_label"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_show_isha"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/isha_label"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/style_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_display_text_uppercase"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/display_text_uppercase_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_display_text_shadow"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/display_text_shadow_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_display_background"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/widget_background_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_customize_background_corner_radius"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/customize_background_corner_radius_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <com.best.deskclock.settings.custompreference.CustomSliderPreference
            android:key="key_namaz_compact_widget_background_corner_radius"
            android:layout="@layout/settings_preference_slider_layout"
            android:title="@string/background_corner_radius_title"
            android:defaultValue="24"
            android:max="100"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_apply_horizontal_padding"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/apply_padding_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/colors_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_default_background_color"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/background_default_color_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <com.best.deskclock.settings.custompreference.ColorPickerPreference
            android:key="key_namaz_compact_widget_custom_background_color"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/background_color_title"
            android:defaultValue="#70000000"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_default_timeline_active_color"
            android:layout="@layout/settings_preference_layout"
            android:title="Timeline active event default color"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <com.best.deskclock.settings.custompreference.ColorPickerPreference
            android:key="key_namaz_compact_widget_custom_timeline_active_color"
            android:layout="@layout/settings_preference_layout"
            android:title="Timeline active event color"
            android:defaultValue="#FFFFFF"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_default_timeline_next_color"
            android:layout="@layout/settings_preference_layout"
            android:title="Timeline next event default color"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <com.best.deskclock.settings.custompreference.ColorPickerPreference
            android:key="key_namaz_compact_widget_custom_timeline_next_color"
            android:layout="@layout/settings_preference_layout"
            android:title="Timeline next event color"
            android:defaultValue="#CCCCCC"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_default_timeline_standard_color"
            android:layout="@layout/settings_preference_layout"
            android:title="Timeline standard event default color"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <com.best.deskclock.settings.custompreference.ColorPickerPreference
            android:key="key_namaz_compact_widget_custom_timeline_standard_color"
            android:layout="@layout/settings_preference_layout"
            android:title="Timeline standard event color"
            android:defaultValue="#FFFFFF"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_display_item_highlight"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/namaz_widget_highlight_item_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_default_item_active_highlight_color"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/namaz_widget_highlight_active_default_color_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <com.best.deskclock.settings.custompreference.ColorPickerPreference
            android:key="key_namaz_compact_widget_custom_item_active_highlight_color"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/namaz_widget_highlight_active_custom_color_title"
            android:defaultValue="#FFFFFF"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="key_namaz_compact_widget_default_item_next_highlight_color"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/namaz_widget_highlight_next_default_color_title"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <com.best.deskclock.settings.custompreference.ColorPickerPreference
            android:key="key_namaz_compact_widget_custom_item_next_highlight_color"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/namaz_widget_highlight_next_custom_color_title"
            android:defaultValue="#FFFFFF"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/font_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">
        <com.best.deskclock.settings.custompreference.CustomSliderPreference
            android:key="key_namaz_compact_widget_maximum_font_size"
            android:layout="@layout/settings_preference_slider_layout"
            android:title="@string/max_clock_font_size_title"
            android:defaultValue="70"
            android:max="200"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
