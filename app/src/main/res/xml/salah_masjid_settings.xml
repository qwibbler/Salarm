<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="key_masjid_events_shown"
        android:layout="@layout/settings_preference_layout"
        android:title="@string/salah_masjid_events_shown_title"
        android:summary="@string/salah_masjid_events_shown_summary"
        app:iconSpaceReserved="false" />

    <PreferenceCategory
        android:key="category_masjids"
        android:title="@string/salah_masjids_category_title"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false">

        <Preference
            android:key="key_add_new_masjid"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/salah_add_new_masjid"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
