<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:drawable="@drawable/ic_tab_salah_static"
        android:state_focused="true" />

    <item
        android:id="@+id/on"
        android:drawable="@drawable/ic_tab_salah_static"
        android:state_selected="true" />

    <item
        android:id="@+id/off"
        android:drawable="@drawable/ic_tab_salah_static" />

    <transition
        android:fromId="@id/off"
        android:toId="@id/on">

        <animated-vector android:drawable="@drawable/ic_tab_salah_static">
            <target
                android:name="sun"
                android:animation="@animator/ic_salah_animation_rotation_ccw" />
            <target
                android:name="moon"
                android:animation="@animator/ic_salah_animation_rotation_cw" />
            <target
                android:name="masjid"
                android:animation="@animator/ic_salah_animation_rotation_ccw" />
        </animated-vector>

    </transition>

</animated-selector>
