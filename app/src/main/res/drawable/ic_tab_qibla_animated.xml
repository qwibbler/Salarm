<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:drawable="@drawable/ic_tab_qibla_static"
        android:state_focused="true" />

    <item
        android:id="@+id/on"
        android:drawable="@drawable/ic_tab_qibla_static"
        android:state_selected="true" />

    <item
        android:id="@+id/off"
        android:drawable="@drawable/ic_tab_qibla_static" />

    <transition
        android:fromId="@id/off"
        android:toId="@id/on">

        <animated-vector android:drawable="@drawable/ic_qibla_for_anim">
            <target
                android:name="group"
                android:animation="@animator/ic_qibla_animation" />
        </animated-vector>

    </transition>

</animated-selector>
