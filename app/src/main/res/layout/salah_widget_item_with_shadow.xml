<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/item_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/salah_item_highlight"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/salah_item_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="2dp">

        <!-- WIDE MODE -->
        <LinearLayout
            android:id="@+id/mode_wide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/label_wide"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/widget_text_color"
                android:includeFontPadding="false"
                android:shadowRadius="2.75"
                android:shadowColor="@android:color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                tools:text="Fajr" />
            <TextView
                android:id="@+id/time_wide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_color"
                android:includeFontPadding="false"
                android:shadowRadius="2.75"
                android:shadowColor="@android:color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                tools:text="5:12 AM" />
        </LinearLayout>

        <!-- NARROW MODE -->
        <LinearLayout
            android:id="@+id/mode_narrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <TextView
                android:id="@+id/label_narrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_color"
                android:textSize="12sp"
                android:paddingHorizontal="3dp"
                android:includeFontPadding="false"
                android:shadowRadius="2.75"
                android:shadowColor="@android:color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                tools:text="Fajr" />
            <TextView
                android:id="@+id/time_narrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_color"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:shadowRadius="2.75"
                android:shadowColor="@android:color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                tools:text="5:12 AM" />
        </LinearLayout>

        <!-- COMPACT MODE (Single line initials) -->
        <LinearLayout
            android:id="@+id/mode_compact_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">
            <TextView
                android:id="@+id/mode_compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_color"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:shadowRadius="2.75"
                android:shadowColor="@android:color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                tools:text="F: 5:12 AM" />
        </LinearLayout>

        <!-- COMPACT VERTICAL MODE (Initials left, Time right) -->
        <LinearLayout
            android:id="@+id/mode_compact_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/initial_compact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:textColor="@color/widget_text_color"
                android:includeFontPadding="false"
                android:shadowRadius="2.75"
                android:shadowColor="@android:color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                tools:text="F" />
            <TextView
                android:id="@+id/time_compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/widget_text_color"
                android:includeFontPadding="false"
                android:shadowRadius="2.75"
                android:shadowColor="@android:color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                tools:text="5:12 AM" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
