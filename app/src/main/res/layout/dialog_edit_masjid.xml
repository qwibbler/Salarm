<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- 1. Top Header: Masjid Icon (Left) + Masjid Name (Clock position) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Masjid Icon Frame with hovering "X" delete button -->
                <FrameLayout
                    android:id="@+id/masjid_icon_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/masjid_icon_preview"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/salah_masjid_icon_title"
                        android:focusable="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_masjid_timings"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/btn_remove_masjid_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:background="?attr/colorErrorContainer"
                        android:clickable="true"
                        android:contentDescription="@string/salah_masjid_remove_icon"
                        android:focusable="true"
                        android:padding="3dp"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:tint="?attr/colorOnErrorContainer" />

                </FrameLayout>

                <!-- Masjid Name Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/masjid_name_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/salah_masjid_name_title">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/masjid_name_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- 2. Interval Picker Section (replacing repeat_days_group) -->
            <LinearLayout
                android:id="@+id/masjid_intervals_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/masjid_intervals_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_repeat"
                    android:drawablePadding="10dp"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    android:gravity="center_vertical"
                    android:text="@string/salah_masjid_intervals_title"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/masjid_intervals_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="2 intervals: &lt;=16 min &amp; &gt;16 min" />

            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                app:dividerColor="?attr/colorOutlineVariant" />

            <!-- 3. Settings Section: Location / Address / Timezone -->

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:paddingHorizontal="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/settings"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <!-- Location Setting Row -->
            <LinearLayout
                android:id="@+id/btn_select_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="2dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_fab_public"
                    android:drawablePadding="10dp"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    android:gravity="center_vertical"
                    android:text="@string/salah_masjid_select_location"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/masjid_coordinates_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="37.7749, -122.4194" />

            </LinearLayout>

            <!-- Timezone Setting Row -->
            <LinearLayout
                android:id="@+id/masjid_timezone_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="2dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_calendar_clock"
                    android:drawablePadding="10dp"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    android:gravity="center_vertical"
                    android:text="@string/salah_masjid_timezone_title"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/masjid_timezone_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="America/New_York" />

            </LinearLayout>

            <!-- Address, City, Country Fields -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/masjid_address_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="8dp"
                android:hint="@string/salah_masjid_address_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/masjid_address_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/masjid_city_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:hint="@string/salah_masjid_city_title">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/masjid_city_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/masjid_country_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:hint="@string/salah_masjid_country_title">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/masjid_country_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
