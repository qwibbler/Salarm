<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Bottom Sheet Drag Handle -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:paddingTop="16dp" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/edit_bottom_sheet_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- 1. Top Header: Masjid Icon (Left) + Full Heading Masjid Name Text / Editable Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Masjid Icon Frame with hovering "X" delete button -->
                <FrameLayout
                    android:id="@+id/masjid_icon_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/masjid_icon_preview"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/masjid_icon_title"
                        android:focusable="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_masjid_timings"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/btn_remove_masjid_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:background="?attr/colorErrorContainer"
                        android:clickable="true"
                        android:contentDescription="@string/masjid_remove_icon"
                        android:focusable="true"
                        android:padding="3dp"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:tint="?attr/colorOnErrorContainer" />

                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1">

                    <!-- Full Heading Text View (default display, no max length) -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/masjid_name_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Default Masjid" />

                    <!-- Editable Input Layout (shown on click, no max length) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/masjid_name_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/masjid_name_title"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/masjid_name_edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </com.google.android.material.textfield.TextInputLayout>

                </FrameLayout>

            </LinearLayout>

            <!-- 3. Settings Section: Location / Timezone / Address / City / Country -->

            <!-- Location Setting Row -->
            <LinearLayout
                android:id="@+id/btn_select_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_fab_public"
                    android:drawablePadding="10dp"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    android:gravity="center_vertical"
                    android:text="@string/masjid_select_location"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/masjid_coordinates_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="37.7749, -122.4194" />

            </LinearLayout>

            <!-- Timezone Setting Row -->
            <LinearLayout
                android:id="@+id/masjid_timezone_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="2dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_calendar_clock"
                    android:drawablePadding="10dp"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    android:gravity="center_vertical"
                    android:text="@string/masjid_timezone_title"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/masjid_timezone_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="America/New_York" />

            </LinearLayout>

            <!-- Address Layout (no expressive card background) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/masjid_address_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="8dp"
                android:hint="@string/masjid_street_address_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/masjid_address_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:scrollHorizontally="true"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- City and Country Container (no expressive card background) -->
            <LinearLayout
                android:id="@+id/masjid_city_country_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/masjid_city_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:hint="@string/masjid_city_title">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/masjid_city_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:scrollHorizontally="true"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/masjid_country_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:hint="@string/masjid_country_title">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/masjid_country_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:scrollHorizontally="true"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- 2. Inline Interval Picker Section -->
            <LinearLayout
                android:id="@+id/interval_section_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/interval_toggle_group"
                    style="@style/Widget.Material3.MaterialButtonGroup.Connected"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_2_intervals"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/masjid_intervals_2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_3_intervals"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/masjid_intervals_3" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/interval_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:stepSize="1"
                    android:valueFrom="1"
                    android:valueTo="30" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/masjid_intervals_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="2 intervals: &lt;=16 days &amp; &gt;16 days" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button Group -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <com.google.android.material.button.MaterialButtonGroup
            android:id="@+id/bottom_button_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/colorAlert"
                app:icon="@drawable/ic_delete"
                app:iconTint="?attr/colorOnError"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                style="?attr/materialButtonOutlinedStyle"
                android:id="@+id/copy_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@drawable/ic_duplicate"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:strokeColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                style="?attr/materialButtonOutlinedStyle"
                android:id="@+id/preview_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@drawable/ic_preview"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:strokeColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/colorGranted"
                app:icon="@drawable/ic_save"
                app:iconTint="?attr/colorSurfaceContainerLowest"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

        </com.google.android.material.button.MaterialButtonGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
