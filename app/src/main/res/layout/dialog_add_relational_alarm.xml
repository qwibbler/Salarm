<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/dialogPreferredPadding"
        android:paddingVertical="12dp"
        android:orientation="vertical">

        <!-- Block 1: Primary Rule -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/relational_alarm_primary_alarm"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="8dp"/>

            <!-- Row 1: Set Alarm At [Value] min -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:alignItems="center">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/RelationalAlarm.DropdownLayout.Numeric">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/primary_offset_value"
                        style="@style/RelationalAlarm.AutoCompleteTextView.Numeric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="999" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/RelationalAlarm.Text"
                    android:text="@string/relational_alarm_minutes" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/primary_offset_toggle"
                    style="@style/RelationalAlarm.TextButton"
                    tools:text="After" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/RelationalAlarm.DropdownLayout">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/primary_event"
                        style="@style/RelationalAlarm.AutoCompleteTextView.Event"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Asr Hanafi" />
                </com.google.android.material.textfield.TextInputLayout>

            </com.google.android.flexbox.FlexboxLayout>

            <!-- Rounding Section -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/primary_round_enabled_checkbox"
                style="@style/RelationalAlarm.HeadingCheckbox"
                android:layout_marginTop="10dp"
                android:text="@string/relational_alarm_round"/>

            <!-- Rounding Row: [Round Toggle] [Round Value] min -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/primary_round_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flexWrap="wrap"
                app:alignItems="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/primary_round_toggle"
                    style="@style/RelationalAlarm.TextButton"
                    tools:text="To the Nearest" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/RelationalAlarm.DropdownLayout.Numeric">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/primary_round_value"
                        style="@style/RelationalAlarm.AutoCompleteTextView.Numeric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="999" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/RelationalAlarm.Text"
                    android:text="@string/relational_alarm_minutes" />
            </com.google.android.flexbox.FlexboxLayout>

            <!-- Adjustment Section Title -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/adjustment_enabled_checkbox"
                style="@style/RelationalAlarm.HeadingCheckbox"
                android:layout_marginTop="10dp"
                android:checked="false"
                android:text="@string/relational_alarm_adjust_alarm" />

            <!-- Adjustment Row: Adjusted by [Value] min [Toggle] -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/adjustment_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flexWrap="wrap"
                app:alignItems="center">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/RelationalAlarm.DropdownLayout.Numeric">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/adjustment_value"
                        style="@style/RelationalAlarm.AutoCompleteTextView.Numeric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="999" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/RelationalAlarm.Text"
                    android:text="@string/relational_alarm_minutes" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/adjustment_toggle"
                    style="@style/RelationalAlarm.TextButton"
                    tools:text="Earlier" />
            </com.google.android.flexbox.FlexboxLayout>

        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:dividerColor="?attr/colorOutlineVariant" />

        <!-- Block 2: Safety Boundary -->
        <LinearLayout
            android:id="@+id/safety_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/safety_enabled_checkbox"
                style="@style/RelationalAlarm.HeadingCheckbox"
                android:text="@string/relational_alarm_safety_boundary" />

            <LinearLayout
                android:id="@+id/safety_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <!-- Sentence: No [Toggle] Than [Value] min -->
                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap"
                    app:alignItems="center">

                    <TextView
                        style="@style/RelationalAlarm.Text"
                        android:text="@string/relational_alarm_no"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/safety_boundary_toggle"
                        style="@style/RelationalAlarm.TextButton"
                        tools:text="Earlier" />

                    <TextView
                        style="@style/RelationalAlarm.Text"
                        android:text="@string/relational_alarm_than" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/RelationalAlarm.DropdownLayout.Numeric">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/safety_offset_value"
                            style="@style/RelationalAlarm.AutoCompleteTextView.Numeric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="999" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/RelationalAlarm.Text"
                        android:text="@string/relational_alarm_minutes" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/safety_offset_toggle"
                        style="@style/RelationalAlarm.TextButton"
                        tools:text="Before" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/RelationalAlarm.DropdownLayout">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/safety_event"
                            style="@style/RelationalAlarm.AutoCompleteTextView.Event"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Sunrise" />
                    </com.google.android.material.textfield.TextInputLayout>
                </com.google.android.flexbox.FlexboxLayout>

                <!-- Rounding Section -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/safety_round_enabled_checkbox"
                    style="@style/RelationalAlarm.HeadingCheckbox"
                    android:layout_marginTop="10dp"
                    android:text="@string/relational_alarm_round" />

                <!-- Rounding Row: [Round Toggle] [Round Value] min -->
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/safety_round_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:flexWrap="wrap"
                    app:alignItems="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/safety_round_toggle"
                        style="@style/RelationalAlarm.TextButton"
                        tools:text="To the Nearest" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/RelationalAlarm.DropdownLayout.Numeric">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/safety_round_value"
                            style="@style/RelationalAlarm.AutoCompleteTextView.Numeric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="999" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/RelationalAlarm.Text"
                        android:text="@string/relational_alarm_minutes" />
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:dividerColor="?attr/colorOutlineVariant" />

        <!-- Block 3: Auto-Stop / Dismiss Boundary -->
        <LinearLayout
            android:id="@+id/autostop_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/autostop_enabled_checkbox"
                style="@style/RelationalAlarm.HeadingCheckbox"
                android:checked="true"
                android:text="@string/relational_alarm_auto_stop" />

            <LinearLayout
                android:id="@+id/autostop_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <!-- Sentence: Dismiss Alarm [Value] min -->
                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap"
                    app:alignItems="center">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/RelationalAlarm.DropdownLayout.Numeric">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/autostop_offset_value"
                            style="@style/RelationalAlarm.AutoCompleteTextView.Numeric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="999" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/RelationalAlarm.Text"
                        android:text="@string/relational_alarm_minutes" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/autostop_offset_toggle"
                        style="@style/RelationalAlarm.TextButton"
                        tools:text="Before" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/RelationalAlarm.DropdownLayout">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/autostop_event"
                            style="@style/RelationalAlarm.AutoCompleteTextView.Event"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Sunrise" />
                    </com.google.android.material.textfield.TextInputLayout>
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
