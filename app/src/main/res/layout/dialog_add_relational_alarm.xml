<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/dialogPreferredPadding"
        android:paddingVertical="12dp"
        android:orientation="vertical">

        <!-- Block 1: Primary Rule -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/relational_alarm_primary_alarm"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="8dp"/>

            <!-- Row 1: Set Alarm At [Value] min -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexWrap="wrap"
                app:alignItems="center">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    app:endIconMinSize="28dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/primary_offset_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="3"
                        android:paddingVertical="8dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="555" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:text="@string/relational_alarm_minutes"
                    android:layout_marginStart="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/primary_offset_toggle"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    tools:text="After" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_flexGrow="1"
                    app:layout_flexShrink="0"
                    android:minWidth="180dp"
                    android:layout_marginStart="4dp"
                    app:endIconMinSize="28dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintEnabled="false">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/primary_event"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:paddingVertical="8dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="Fajr" />
                </com.google.android.material.textfield.TextInputLayout>

            </com.google.android.flexbox.FlexboxLayout>

            <!-- Rounding Section -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/primary_round_enabled_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/relational_alarm_round"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary" />

            <!-- Rounding Row: [Round Toggle] [Round Value] min -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/primary_round_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flexWrap="wrap"
                app:alignItems="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/primary_round_toggle"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    tools:text="To the Nearest" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:endIconMinSize="28dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintEnabled="false">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/primary_round_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="0dp"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="0" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:text="@string/relational_alarm_minutes"
                    android:layout_marginStart="4dp" />
            </com.google.android.flexbox.FlexboxLayout>

            <!-- Adjustment Section Title -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/adjustment_enabled_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="0dp"
                android:checked="false"
                android:text="@string/relational_alarm_adjust_alarm"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary" />

            <!-- Adjustment Row: Adjusted by [Value] min [Toggle] -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/adjustment_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:flexWrap="wrap"
                app:alignItems="center">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    app:endIconMinSize="28dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintEnabled="false">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/adjustment_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="0dp"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="0" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:text="@string/relational_alarm_minutes" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/adjustment_toggle"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="4dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    tools:text="Earlier" />
            </com.google.android.flexbox.FlexboxLayout>

        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:dividerColor="?attr/colorOutlineVariant" />

        <!-- Block 2: Safety Boundary -->
        <LinearLayout
            android:id="@+id/safety_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/safety_enabled_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:checked="false"
                android:text="@string/relational_alarm_safety_boundary"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/safety_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <!-- Sentence: No [Toggle] Than [Value] min -->
                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap"
                    app:alignItems="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:text="@string/relational_alarm_no"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/safety_boundary_toggle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="Earlier" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:text="@string/relational_alarm_than"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        app:endIconMinSize="28dp"
                            app:boxBackgroundColor="@android:color/transparent"
                        app:hintEnabled="false">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/safety_offset_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="0dp"
                            android:gravity="center"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="5" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:text="@string/relational_alarm_minutes"
                        android:layout_marginStart="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/safety_offset_toggle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="Before" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_flexGrow="1"
                        app:layout_flexShrink="0"
                        android:minWidth="180dp"
                        android:layout_marginStart="4dp"
                        app:endIconMinSize="28dp"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:hintEnabled="false">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/safety_event"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:paddingVertical="8dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="Sunrise" />
                    </com.google.android.material.textfield.TextInputLayout>
                </com.google.android.flexbox.FlexboxLayout>

                <!-- Rounding Section -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/safety_round_enabled_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/relational_alarm_round"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorPrimary" />

                <!-- Rounding Row: [Round Toggle] [Round Value] min -->
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/safety_round_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:flexWrap="wrap"
                    app:alignItems="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/safety_round_toggle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="To the Nearest" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        app:endIconMinSize="28dp"
                            app:boxBackgroundColor="@android:color/transparent"
                        app:hintEnabled="false">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/safety_round_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="0dp"
                            android:gravity="center"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="0" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:text="@string/relational_alarm_minutes" />
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:dividerColor="?attr/colorOutlineVariant" />

        <!-- Block 3: Auto-Stop / Dismiss Boundary -->
        <LinearLayout
            android:id="@+id/autostop_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/autostop_enabled_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:checked="true"
                android:text="@string/relational_alarm_auto_stop"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/autostop_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <!-- Sentence: Dismiss Alarm [Value] min -->
                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap"
                    app:alignItems="center">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        app:endIconMinSize="28dp"
                            app:boxBackgroundColor="@android:color/transparent"
                        app:hintEnabled="false">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/autostop_offset_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="0dp"
                            android:gravity="center"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="0" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:text="@string/relational_alarm_minutes" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/autostop_offset_toggle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="Before" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_flexGrow="1"
                        app:layout_flexShrink="0"
                        android:minWidth="180dp"
                        android:layout_marginStart="4dp"
                        app:endIconMinSize="28dp"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:hintEnabled="false">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/autostop_event"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:paddingVertical="8dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="Sunrise" />
                    </com.google.android.material.textfield.TextInputLayout>
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
