<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/salarm_viewing_options_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/use_current_location_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/salarm_use_current_location"
        android:layout_marginBottom="16dp"
        app:icon="@drawable/ic_tab_salah_static" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/salarm_temporary_view_location_label"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pick_city_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/salarm_select_another_city"
        android:layout_marginBottom="4dp"
        app:icon="@drawable/ic_search" />

    <TextView
        android:id="@+id/current_view_city_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:tools="http://schemas.android.com/tools"
        tools:text="Currently viewing: Default"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal" />

    <TextView
        android:id="@+id/recent_locations_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/salarm_recent_locations_title"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/recent_locations_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/recent_locations_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true" />
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/salarm_display_timezone_label"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/timezone_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <AutoCompleteTextView
            android:id="@+id/timezone_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:hint="@string/salarm_select_timezone_hint" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
